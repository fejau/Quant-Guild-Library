# Optional: load GATEWAY_URL and IBKR_ACCOUNT_ID from an existing local project.
# The local .env values below override values from this shared file.
IBKR_SHARED_ENV_FILE=/absolute/path/to/existing/project/.env

# Existing IBKR Client Portal Gateway (credentials stay inside the gateway).
GATEWAY_URL=https://localhost:5001/v1/api
IBKR_ACCOUNT_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AGENT_MAX_ITERATIONS=12

# Trading mode is fail-closed. Start here.
IBKR_TRADING_MODE=readonly

# To arm live submission, ALL of these are required:
#   1. IBKR_TRADING_MODE=live
#   2. IBKR_LIVE_TRADING_ENABLED=true
#   3. IBKR_LIVE_TRADING_CONFIRM=I_UNDERSTAND_LIVE_IBKR_RISK
#   4. explicit IBKR_ACCOUNT_ID
#   5. explicit symbol allowlist
#   6. per-order human approval in the UI
IBKR_LIVE_TRADING_ENABLED=false
IBKR_LIVE_TRADING_CONFIRM=

# Paper mode uses the same human approval flow. It must connect to a paper
# account whose id normally starts with DU.
IBKR_PAPER_TRADING_ENABLED=false

# Hard execution limits.
IBKR_ALLOWED_SYMBOLS=
IBKR_MAX_ORDER_NOTIONAL=500
IBKR_MAX_POSITION_PCT=0.05
IBKR_ALLOW_SHORTING=false
IBKR_REQUIRE_LIMIT_ORDERS=true
IBKR_STAGE_TTL_SECONDS=900

# Local app only.
APP_HOST=127.0.0.1
APP_PORT=5050
APP_DEBUG=false
